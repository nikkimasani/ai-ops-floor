{
  "_readme": "Copy to config/services.json and replace the demo services. Every URL/secret here is a PLACEHOLDER. Secrets are referenced as env:NAME and come from GitHub Actions secrets: never write a real token in this file.",
  "site": {
    "title": "AI Ops Floor",
    "intervalMin": 5,
    "categories": {
      "ai-hub": {
        "label": "AI Hub Apps",
        "room": "bullpen"
      },
      "azure-function": {
        "label": "Azure Function Apps",
        "room": "review"
      },
      "ops-queue": {
        "label": "Ticket Queues",
        "room": "bullpen"
      }
    }
  },
  "services": [
    {
      "id": "example-app",
      "name": "Example App",
      "category": "ai-hub",
      "owner": "Your Team Name",
      "tier": 1,
      "check": {
        "adapter": "http",
        "url": "https://REPLACE-ME.example.invalid/health",
        "expectStatus": 200,
        "timeoutMs": 8000
      },
      "thresholds": {
        "degradedMs": 2000,
        "downAfter": 3
      }
    },
    {
      "id": "func-example",
      "name": "func-example",
      "category": "azure-function",
      "owner": "Your Team Name",
      "tier": 2,
      "dependsOn": [],
      "check": {
        "adapter": "http",
        "url": "https://REPLACE-ME.example.invalid/api/health",
        "headers": {
          "x-functions-key": "env:FUNC_EXAMPLE_KEY"
        },
        "expectStatus": 200,
        "expectBodyIncludes": "\"status\":\"ok\"",
        "timeoutMs": 10000
      },
      "thresholds": {
        "degradedMs": 4000,
        "downAfter": 3
      }
    },
    {
      "id": "licence-requests",
      "name": "Licence Requests Queue",
      "category": "ops-queue",
      "owner": "Your Team Name",
      "tier": 2,
      "check": {
        "adapter": "servicenow",
        "instance": "env:SN_INSTANCE",
        "user": "env:SN_USER",
        "password": "env:SN_PASSWORD",
        "table": "incident",
        "query": "active=true^assignment_group=REPLACE_WITH_GROUP_SYS_ID",
        "maxOpen": 30,
        "maxOldestHours": 72,
        "slaHours": 48
      },
      "thresholds": {
        "downAfter": 9999
      }
    }
  ]
}
